# Dependencies
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/

# Logs
*.log

# skill-creator eval scratch (transient; would otherwise ship under skills/**)
skills/*-workspace/

# generated eval-viewer artifact (transient; regenerated from benchmark + outputs)
workspaces/**/review.html

# baseline skill copy for eval runs (materialized on demand from git history)
workspaces/*/skill-snapshot/
# cook:begin io.github.lmarqs.cookbook:git#worktrees/worktrees
# io.github.lmarqs.cookbook:git#worktrees --instructions=AGENTS.md
/.worktrees/*
!/.worktrees/README.md
!/.worktrees/setup
!/.worktrees/teardown
# cook:end io.github.lmarqs.cookbook:git#worktrees/worktrees
# cook:begin io.github.lmarqs.cookbook:agents#connect/harnesses
# io.github.lmarqs.cookbook:agents#connect --harness=claude --worktree-setup=.worktrees/setup --worktree-teardown=.worktrees/teardown --worktree-branch-prefix=agent/
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills
!/.claude/commands
# Claude Code skips AGENTS.md while any of these exists, so they stay out of commits.
CLAUDE.md
CLAUDE.local.md
**/.claude/CLAUDE.md
